//DB collection ieeeData
    var getValidKeywordDois =
        [
            {
                '$addFields': {
                    'year': {
                        '$year': '$published'
                    },
                    'lenA': {
                        '$strLenCP': '$abstract'
                    },
                    'lenL': {
                        '$strLenCP': '$label'
                    },
                    'keyWords': {
                        '$concatArrays': [
                            '$ieeeKeyW', '$authorKW'
                        ]
                    }
                }
            }, {
            '$match': {
                'keyWords': {
                    '$ne': null
                },
                '$or': [
                    {
                        'ieeeKeyW': {
                            '$exists': true
                        }
                    }, {
                        'authorKW': {
                            '$exists': true
                        }
                    }
                ],
                'year': {
                    '$gte': 2016
                },
                'lenA': {
                    '$gt': 0
                },
                'lenL': {
                    '$gt': 0
                }
            }
        }, {
            '$addFields': {
                'joinedString': {
                    '$rtrim': {
                        'input': {
                            '$reduce': {
                                'input': '$keyWords',
                                'initialValue': '',
                                'in': {
                                    '$concat': [
                                        '$$value', {
                                            '$toString': '$$this'
                                        }, ', '
                                    ]
                                }
                            }
                        },
                        'chars': ', '
                    }
                }
            }
        }, {
            '$match': {
                'joinedString': {
                    '$not':regExArray,
                }
            }
        }, {
            '$unwind': {
                'path': '$keyWords'
            }
        }, {
            '$addFields': {
                'doitext': {
                    '$concat': [
                        {
                            '$toLower': '$doi'
                        }, '<<>>', {
                            '$toString': '$year'
                        }, '<<>>', '$abstract', ' ** ', '$label'
                    ]
                }
            }
        }, {
            '$group': {
                '_id': 'doi',
                'dois': {
                    '$addToSet': '$doitext'
                },
                'keyWords': {
                    '$addToSet': {
                        '$trim': {
                            'input': '$keyWords'
                        }
                    }
                }
            }
        }, {
            '$project': {
                'keyWords': {
                    '$sortArray': {
                        'input': '$keyWords',
                        'sortBy': 1
                    }
                },
                'dois': {
                    '$sortArray': {
                        'input': '$dois',
                        'sortBy': 1
                    }
                }
            }
        }
        ];
        
